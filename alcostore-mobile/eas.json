{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.16.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk", "credentialsSource": "remote" },
      "ios": { "buildConfiguration": "Debug", "credentialsSource": "remote" },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://alcostore-api-dev.sigortamat90.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://alcostore-web-dev.sigortamat90.workers.dev"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk", "credentialsSource": "remote" },
      "ios": { "credentialsSource": "remote" },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://alcostore-api-dev.sigortamat90.workers.dev",
        "EXPO_PUBLIC_WEB_URL": "https://alcostore-web-dev.sigortamat90.workers.dev"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle", "credentialsSource": "remote" },
      "ios": { "buildConfiguration": "Release", "credentialsSource": "remote" },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://alco.turmat.az",
        "EXPO_PUBLIC_WEB_URL": "https://alcoweb.turmat.az"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "REPLACE_WITH_ASC_APP_ID",
        "bundleIdentifier": "app.alcostore.ios"
      }
    }
  }
}
